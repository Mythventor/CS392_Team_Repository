{
  "name": "passdown",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:emulator": "firebase emulators:exec --only auth,firestore --project demo-passdown \"node scripts/seed-emulator.mjs && vite --mode emulator\"",
    "test": "npm run test:unit && npm run test:components",
    "test:rules": "firebase emulators:exec --only firestore --project demo-passdown \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:unit": "node --test tests/*.test.mjs",
    "test:components": "vitest run",
    "test:components:watch": "vitest"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  }
}
