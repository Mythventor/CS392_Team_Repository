{
  "rules": {
    "owners": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "classes": {
          "$classId": {
            ".write": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider !== 'anonymous' || data.exists() || root.child('owners').child($uid).child('classes').exists() === false)"
          }
        }
      }
    },
    "publicClasses": {
      "$classId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['ownerUid', 'name', 'prompt'])",
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "prompt": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "meetingTime": {
          ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
        },
        "timeZone": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "requireDiscussionResponse": {
          ".validate": "newData.isBoolean()"
        },
        "graceMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
        },
        "recurring": {
          ".validate": "newData.isBoolean()"
        },
        "meetingDays": {
          ".validate": "newData.isString() && newData.val().matches(/^([0-6](,[0-6])*)?$/)"
        },
        "attendanceSessionId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessionTokens": {
      "$classId": {
        ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['ownerUid', 'code'])",
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length === 12"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "checkins": {
      "$classId": {
        ".read": "auth != null && root.child('publicClasses').child($classId).child('ownerUid').val() === auth.uid",
        "$checkinId": {
          ".write": "auth != null && ((root.child('publicClasses').child($classId).child('ownerUid').val() === auth.uid) || (!data.exists() && newData.child('sessionCode').val() === root.child('sessionTokens').child($classId).child('code').val()))",
          ".validate": "newData.hasChildren(['name', 'studentId', 'status', 'checkedInTime', 'sessionId', 'arrivalStatus', 'sessionCode']) && (root.child('publicClasses').child($classId).child('requireDiscussionResponse').val() !== true || (newData.child('discussionResponse').isString() && newData.child('discussionResponse').val().length > 0))",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "studentId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "status": {
            ".validate": "newData.val() === 'Present'"
          },
          "checkedInTime": {
            ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
          },
          "sessionId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
          },
          "arrivalStatus": {
            ".validate": "newData.val() === 'On time' || newData.val() === 'Late'"
          },
          "sessionCode": {
            ".validate": "newData.isString()"
          },
          "discussionResponse": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
