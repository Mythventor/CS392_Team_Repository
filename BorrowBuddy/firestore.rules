rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function textUpTo(value, max) { return value is string && value.size() <= max; }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'school', 'bio', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'school', 'bio'])
        && textUpTo(data.displayName, 60)
        && textUpTo(data.school, 40)
        && textUpTo(data.bio, 280)
        && (!('photoURL' in data) || data.photoURL == null || textUpTo(data.photoURL, 2048));
    }

    function validItem(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && textUpTo(data.category, 40)
        && textUpTo(data.school, 40)
        && data.status in ['available', 'unavailable']
        && (!('description' in data) || textUpTo(data.description, 2000))
        && (!('pickupArea' in data) || textUpTo(data.pickupArea, 120))
        && (!('condition' in data) || data.condition in ['Like new', 'Good', 'Fair'])
        && (!('photoURL' in data) || textUpTo(data.photoURL, 2048))
        && (!('photoPublicId' in data) || textUpTo(data.photoPublicId, 512))
        && (!('photoPath' in data) || data.photoPath == '' || data.photoPath.matches('items/' + request.auth.uid + '/.*'))
        && (!('availableFrom' in data) || data.availableFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('availableTo' in data) || data.availableTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('availableFrom' in data) || !('availableTo' in data) || data.availableFrom <= data.availableTo)
        && (!('archived' in data) || (data.archived is bool && (!data.archived || data.status == 'unavailable')));
    }

    // ----- Borrowing (see src/borrowing/requests.js) -----

    function validDay(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function dayStart(day) {
      let parts = day.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }
    function participant(loan) {
      return signedIn() && (loan.ownerId == request.auth.uid || loan.borrowerId == request.auth.uid);
    }
    function isOwnerOf(loan) { return signedIn() && loan.ownerId == request.auth.uid; }
    function isBorrowerOf(loan) { return signedIn() && loan.borrowerId == request.auth.uid; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function moves(from, to) {
      return resource.data.status == from && request.resource.data.status == to
        && request.resource.data.updatedAt == request.time;
    }
    function lockPath(itemId, day) {
      return /databases/$(database)/documents/items/$(itemId)/bookedDays/$(day);
    }
    function lockHeldBy(itemId, day, requestId) {
      return existsAfter(lockPath(itemId, day)) && getAfter(lockPath(itemId, day)).data.requestId == requestId;
    }

    // A new request: the borrower asks for up to 14 days inside the listing's dates.
    function validNewRequest(data) {
      let item = get(/databases/$(database)/documents/items/$(data.itemId)).data;
      return data.keys().hasOnly(['itemId', 'itemTitle', 'itemPhotoURL', 'ownerId', 'ownerName', 'borrowerId',
          'borrowerName', 'startDate', 'endDate', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.borrowerId == request.auth.uid
        && data.ownerId != request.auth.uid
        && data.status == 'pending'
        && data.createdAt == request.time && data.updatedAt == request.time
        && validDay(data.startDate) && validDay(data.endDate)
        && data.startDate <= data.endDate
        && dayStart(data.endDate) <= dayStart(data.startDate) + duration.value(13, 'd')
        // A day of slack covers time zones; the app itself blocks past days.
        && dayStart(data.startDate) > request.time - duration.value(2, 'd')
        && textUpTo(data.message, 500)
        && textUpTo(data.itemTitle, 80) && textUpTo(data.itemPhotoURL, 2048)
        && textUpTo(data.ownerName, 60) && textUpTo(data.borrowerName, 60)
        && item.ownerId == data.ownerId
        && item.status == 'available'
        && item.get('archived', false) == false
        && item.get('availableFrom', '0000-00-00') <= data.startDate
        && data.endDate <= item.get('availableTo', '9999-12-31');
    }

    function validPickupPlan(plan) {
      return plan.keys().hasOnly(['place', 'time', 'note', 'proposedBy', 'confirmedBy'])
        && plan.place is string && plan.place.size() > 0 && plan.place.size() <= 120
        && plan.time is string && plan.time.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && textUpTo(plan.note, 200);
    }
    // Either person proposes a plan; only the other person can confirm it, unchanged.
    function pickupChange() {
      let plan = request.resource.data.pickup;
      let old = resource.data.get('pickup', null);
      return resource.data.status in ['accepted', 'picked_up']
        && onlyChanges(['pickup', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validPickupPlan(plan)
        && (
          (plan.proposedBy == request.auth.uid && plan.confirmedBy == null)
          || (old != null && plan.confirmedBy == request.auth.uid && old.proposedBy != request.auth.uid
              && plan.place == old.place && plan.time == old.time && plan.note == old.note
              && plan.proposedBy == old.proposedBy)
        );
    }

    function statusChange(requestId) {
      let loan = resource.data;
      let next = request.resource.data;
      return (
        // Owner accepts: the first and last day must be locked for this request in the same write.
        (isOwnerOf(loan) && moves('pending', 'accepted') && onlyChanges(['status', 'acceptedAt', 'updatedAt'])
          && next.acceptedAt == request.time
          && lockHeldBy(loan.itemId, loan.startDate, requestId) && lockHeldBy(loan.itemId, loan.endDate, requestId))
        || (isOwnerOf(loan) && moves('pending', 'declined')
          && onlyChanges(['status', 'declinedAt', 'declineReason', 'updatedAt'])
          && next.declinedAt == request.time && textUpTo(next.get('declineReason', ''), 200))
        // The borrower can withdraw a pending request; either person can cancel before pickup.
        || (((isBorrowerOf(loan) && moves('pending', 'cancelled')) || (participant(loan) && moves('accepted', 'cancelled')))
          && onlyChanges(['status', 'cancelledAt', 'cancelledBy', 'updatedAt'])
          && next.cancelledAt == request.time && next.cancelledBy == request.auth.uid)
        || (participant(loan) && moves('accepted', 'picked_up')
          && onlyChanges(['status', 'pickedUpAt', 'pickedUpBy', 'updatedAt'])
          && next.pickedUpAt == request.time && next.pickedUpBy == request.auth.uid)
        // Only the owner can say the item came back.
        || (isOwnerOf(loan) && moves('picked_up', 'returned')
          && onlyChanges(['status', 'returnedAt', 'updatedAt']) && next.returnedAt == request.time)
      );
    }

    function lockable(itemId, day, requestId) {
      let loan = getAfter(/databases/$(database)/documents/requests/$(requestId)).data;
      return loan.ownerId == request.auth.uid && loan.itemId == itemId && loan.status == 'accepted'
        && loan.startDate <= day && day <= loan.endDate;
    }
    function releasable(requestId) {
      let loan = getAfter(/databases/$(database)/documents/requests/$(requestId)).data;
      return participant(loan) && loan.status in ['cancelled', 'returned'];
    }

    match /requests/{requestId} {
      allow read: if participant(resource.data);
      allow create: if signedIn() && validNewRequest(request.resource.data);
      allow update: if participant(resource.data) && (statusChange(requestId) || pickupChange());
      // Requests are kept as a record of the loan.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(get(/databases/$(database)/documents/requests/$(requestId)).data);
        allow create: if participant(get(/databases/$(database)/documents/requests/$(requestId)).data)
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && textUpTo(request.resource.data.senderName, 60)
          && request.resource.data.createdAt == request.time;
      }
    }

    // One document per booked day. It can only be created, never overwritten, so two
    // accepted loans can't share a day. Anyone can read which days are taken.
    match /items/{itemId}/bookedDays/{day} {
      allow read: if true;
      allow create: if signedIn() && validDay(day)
        && request.resource.data.keys().hasOnly(['requestId'])
        && lockable(itemId, day, request.resource.data.requestId);
      // Released when the loan is cancelled or returned.
      allow delete: if signedIn() && (resource == null || releasable(resource.data.requestId));
    }

    // Profiles are visible to signed-in students. Only the owner can change theirs.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid) && validProfile(request.resource.data);
      allow update: if isUser(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Anyone can browse items. Only the owner can change or remove a listing.
    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validItem(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && validItem(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
