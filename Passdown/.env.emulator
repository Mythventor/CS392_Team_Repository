# Used by `npm run dev:emulator`. These are not secrets: "demo-" projects only exist locally.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-passdown.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-passdown
VITE_FIREBASE_APP_ID=demo-app

# Photos still use Cloudinary; set its two public variables in .env.local.
